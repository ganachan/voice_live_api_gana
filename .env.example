# Azure OpenAI / AI Foundry connection
# Required: Your Azure OpenAI endpoint URL
AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com/

# Required: The deployment name for your realtime model
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-realtime-mini

# Optional: API version (defaults to 2025-05-01-preview)
# AZURE_OPENAI_API_VERSION=2025-05-01-preview

# Set to "true" to serve config (endpoint, token, deployment) to the frontend
RETURN_CONFIGS=true

# Comma-separated allowed CORS origins (set automatically by Bicep for SWA deployments)
# ALLOWED_ORIGINS=https://your-swa.azurestaticapps.net
